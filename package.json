{
  "name": "@glfm-mark/vue",
  "version": "0.1.0",
  "description": "面向 GitLab Pages / MkDocs 静态站点的 GLFM 所见即所得编辑器",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./standalone": {
      "types": "./dist/standalone.d.ts",
      "import": "./dist/standalone.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:types && npm run build:lib && npm run build:standalone",
    "build:types": "vue-tsc -p tsconfig.build.json",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:standalone": "vite build --config vite.standalone.config.ts",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "fixtures": "node --experimental-strip-types tools/generate-fixtures.ts"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-blockquote": "3.31.3",
    "@tiptap/extension-bold": "3.31.3",
    "@tiptap/extension-bullet-list": "3.31.3",
    "@tiptap/extension-code": "3.31.3",
    "@tiptap/extension-code-block": "3.31.3",
    "@tiptap/extension-document": "3.31.3",
    "@tiptap/extension-hard-break": "3.31.3",
    "@tiptap/extension-heading": "3.31.3",
    "@tiptap/extension-horizontal-rule": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-italic": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-list": "3.31.3",
    "@tiptap/extension-ordered-list": "3.31.3",
    "@tiptap/extension-paragraph": "3.31.3",
    "@tiptap/extension-strike": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-text": "3.31.3",
    "@tiptap/extensions": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/vue-3": "3.31.3",
    "dompurify": "3.4.15",
    "highlight.js": "11.12.0",
    "katex": "0.18.7",
    "lowlight": "3.3.0",
    "mermaid": "11.17.2",
    "prosemirror-markdown": "1.13.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.5.0",
    "jsdom": "30.0.1",
    "markdown-it": "14.3.1",
    "markdown-it-footnote": "4.0.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "vue": "3.5.42",
    "vue-tsc": "3.3.11"
  }
}
